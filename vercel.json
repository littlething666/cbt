{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "app/actions/analyze.ts": {
      "runtime": "edge"
    }
  },
  "headers": [
    {
      "source": "/(quiz)/result",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
